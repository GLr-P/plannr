<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "app": the unpacked Plannr app (GitHub artifact app-unsigned, a zip). -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="Plannr.exe" />
      <include path="*.dll" min-matches="1" max-matches="unbounded" />
      <include path="resources/elevate.exe" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
